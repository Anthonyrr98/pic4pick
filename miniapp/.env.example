# Only public configuration. Copy to .env.local, which Git ignores.
PIC4PICK_API_BASE_URL=
PIC4PICK_SUPABASE_URL=
PIC4PICK_SUPABASE_ANON_KEY=
PIC4PICK_MEDIA_BASE_URL=
# Optional same licensed fonts served from a permitted HTTPS CDN.
PIC4PICK_TITLE_FONT_URL=
PIC4PICK_BODY_FONT_URL=
# Optional native map personalization, after activation in WeChat MP.
# Set BOTH the public subkey and its published style ID. Never put a SecretKey here.
PIC4PICK_TENCENT_MAP_SUBKEY=
PIC4PICK_TENCENT_MAP_STYLE_ID=
